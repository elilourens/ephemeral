# ephemeral — copy to .env and fill in before `docker compose up`.
# Generate secrets with:  openssl rand -base64 32

# REQUIRED in production — app auth token signing key (>= 32 bytes)
JWT_SECRET=

# REQUIRED in production — at-rest encryption key for messages + files
# (base64 of exactly 32 bytes). Losing it means losing all stored content.
ENCRYPTION_KEY=

# Database password (compose wires it to both postgres and the app)
DB_PASSWORD=ephemeral

# LiveKit shared secret — must be >= 32 chars
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=livekit-dev-secret-please-change-me-0123456789

# Where the BROWSER reaches LiveKit signaling.
#   plain LAN/tailnet:  ws://<host-ip>:7880
#   behind Caddy TLS:   wss://<your-domain>   (the tls profile proxies /rtc)
LIVEKIT_URL=ws://localhost:7880

# Message lifetime + purge cadence
RETENTION=7d
CLEANUP_INTERVAL=15m

# Only used by the `tls` profile (docker compose --profile tls up):
# a domain whose DNS points at this box; Caddy fetches certificates itself.
DOMAIN=chat.example.com

# Optional: Tenor API key to enable the GIF picker
TENOR_KEY=

# Maximum privacy: set false to keep NO search index (text search stops working;
# by default the index stores only word stems, never readable message bodies)
SEARCH_INDEX=true
